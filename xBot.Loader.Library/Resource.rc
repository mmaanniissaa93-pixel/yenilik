#include <windows.h>

#define VER_FILEVERSION             0,6,1,0
#define VER_FILEVERSION_STR         "0.6.1.0\0"
#define VER_PRODUCTVERSION          0,6,1,0
#define VER_PRODUCTVERSION_STR      "0.6.1.0\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ProjexNET\0"
            VALUE "FileDescription",  "xBot Client Hook Library\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "Client.Library.dll\0"
            VALUE "LegalCopyright",   "Copyright (C) Engels Quintero 2025-2026\0"
            VALUE "OriginalFilename", "Client.Library.dll\0"
            VALUE "ProductName",      "xBot\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
